{
  "name": "vr-assistant-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "electron:pack": "electron-builder --dir",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint \"electron/**/*.js\" \"src/**/*.js\" \"src/**/*.jsx\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "electron": "^33.2.1",
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "vite": "^6.0.7"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.yuki.vrassistant",
    "productName": "VR Assistant",
    "files": [
      "dist/**",
      "electron/**",
      "src/services/**",
      "src/emotion_map.json",
      "package.json"
    ]
  }
}
